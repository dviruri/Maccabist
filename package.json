{
  "name": "maccabist",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "מכביסט - a Hebrew football career simulation game",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "tsc -p tsconfig.test.json && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "simulate": "vite-node scripts/simulate.ts --",
    "simulate:large": "vite-node scripts/simulate.ts -- --careers=20000",
    "cup-metrics": "vite-node scripts/cupMetrics.ts --"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-node": "^2.1.9",
    "vitest": "^2.1.8"
  }
}
