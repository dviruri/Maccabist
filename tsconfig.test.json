{
  /*
   * Test project.
   *
   * Inherits every strictness setting from the app project and adds tests/ and the
   * simulation CLI on top, so `npm test` really does compile and validate the tests
   * without those files ever being able to break `npm run build`.
   */
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vite/client", "node"]
  },
  "include": ["src", "tests", "scripts", "vite.config.ts"]
}
